{%- macro icon(name, class="", title="") -%}
<svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="{{ 'false' if title else 'true' }}"{% if title %} role="img"><title>{{ title }}</title>{% else %}>{% endif %}{{ paths[name] | safe }}</svg>
{%- endmacro -%}
