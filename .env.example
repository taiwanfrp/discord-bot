DISCORD_TOKEN=your_discord_bot_token_here
# bot 服務的 Discord 伺服器
GUILD_ID=

# sqlite+aiosqlite:///data/bot.db
# mysql+aiomysql://user:pass@host/db?charset=utf8mb4（MySQL、MariaDB；建立資料庫時要指定 CHARACTER SET utf8mb4）
# postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# queue、事件通知、鎖使用的 Redis（單一主節點）；不要用 db 編號區分資料
REDIS_URL=redis://localhost:6379

# Fernet 金鑰，逗號分隔，第一個是目前使用的金鑰。金鑰遺失資料就無法還原，請另外備份。
# 產生：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=

# S3 相容儲存（附件、頭像）。本機開發使用 compose.yaml 的 Silo，帳密與那裡相同
# 正式環境：S3_ENDPOINT 留空表示 AWS；金鑰只能存取這個 bucket
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ticket-bot
S3_SECRET_ACCESS_KEY=ticket-bot-dev-password
S3_BUCKET=ticket-bot
# presigned URL 的有效期限（秒）
S3_PRESIGN_TTL=600
# bucket 的 CORS 要允許 API_CORS_ORIGINS 用 PUT 上傳（本機開發用 create_bucket 設定）

# bot 對外的網址（Discord 要連得到），用來組出附件的分享連結
PUBLIC_BASE_URL=http://localhost:8000
# 網頁上紀錄頁面的網址（關單後私訊的連結），{id} 會換成客服單 id
WEB_TICKET_URL=http://localhost:3000/tickets/{id}

# API（見 docs/auth.md）
# 本機開發用 127.0.0.1。容器裡不用設定，image 預設是 0.0.0.0（port 只讓自己的 reverse proxy 連進來）
API_HOST=127.0.0.1
API_PORT=8000
# 前端的 origin，逗號分隔
API_CORS_ORIGINS=http://localhost:3000
# 信任的 proxy IP（逗號分隔），只有它們送來的 X-Forwarded-For 會被採用
FORWARDED_ALLOW_IPS=127.0.0.1
# 主要 API 的 session store（專用帳號，只能讀取 session:*、讀取並刪除 ticket_code:*）
# 本機開發時可以指到上面的 Redis
SESSION_REDIS_URL=redis://localhost:6379
# 以下有預設值，通常不用改
# AUTH_COOKIE_NAME=__Host-ticket_session
# TICKET_SESSION_TTL=259200
